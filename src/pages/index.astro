---
import '@/styles/global.css';
const canonical = new URL('/', Astro.site);
const seoTitle = 'Free video tools that run in your browser';
const description = 'Make videos with cycling fonts, convert horizontal video to a vertical split screen, and transcribe video to text. Free, no accounts. Files stay on your device.';
const tools = [
  { href: 'font-cycle', name: 'Font cycle', description: 'Make a video with changing fonts over your image.' },
  { href: 'horizontal-to-vertical', name: 'Horizontal to vertical', description: 'Convert a wide video to vertical with two stacked crops.' },
  { href: 'transcribe-reels', name: 'Video to text', description: 'Transcribe a video to text without uploading it.' },
];
const articles = [
  { href: '/blog/font-cycle/', title: 'Make a video with cycling fonts', image: '/blog/thumbs/font-cycle.svg', alt: 'The same coffee image and words shown in three different fonts' },
  { href: '/blog/horizontal-to-vertical/', title: 'Convert horizontal video to vertical', image: '/blog/thumbs/horizontal-to-vertical.svg', alt: 'Two cyclists cropped from a wide video and stacked in a portrait frame' },
  { href: '/blog/transcribe-video/', title: 'Transcribe video without uploading it', image: '/blog/thumbs/transcribe-video.svg', alt: 'A speaker in a video beside a timestamped transcript' },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: "Oh it's focused",
  url: canonical.href,
  description,
  hasPart: tools.map((tool) => ({ '@type': 'WebPage', name: tool.name, description: tool.description, url: new URL(`/tools/${tool.href}/`, Astro.site).href })),
};
---
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Oh it's focused" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={`${seoTitle} · Oh it's focused`} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${seoTitle} · Oh it's focused`} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <title>{seoTitle} · Oh it's focused</title>
  </head>
  <body class="min-h-dvh antialiased">
    <main class="mx-auto flex min-h-svh max-w-xl flex-col justify-center px-6 py-12">
      <h1 class="text-lg font-medium">Oh it's focused.</h1>
      <p class="mt-2 text-sm text-muted-foreground">Small tools for everyday content.</p>
      <nav aria-label="Creator tools" class="my-8 divide-y divide-border">
        {tools.map(tool => <a href={`/tools/${tool.href}/`} class="group flex items-center justify-between gap-4 py-5">
          <div><h2 class="text-sm font-medium group-hover:underline underline-offset-4">{tool.name}</h2><p class="mt-1 text-sm text-muted-foreground">{tool.description}</p></div>
          <span aria-hidden="true" class="text-muted-foreground">↗</span>
        </a>)}
      </nav>
      <p class="text-xs text-muted-foreground">No accounts. Your files stay on this device.</p>
      <section aria-label="Blog" class="mt-8 border-t border-border pt-5 text-sm">
        <h2 class="text-xs font-medium text-muted-foreground">Blog</h2>
        <nav aria-label="Blog articles" class="mt-3 grid gap-5 sm:grid-cols-3">
          {articles.map(article => <a href={article.href} class="group min-w-0 space-y-2 py-1">
            <img src={article.image} alt={article.alt} width="480" height="320" loading="lazy" decoding="async" class="aspect-[3/2] w-full rounded-md object-cover" />
            <span class="block leading-5 group-hover:underline underline-offset-4">{article.title}</span>
          </a>)}
        </nav>
      </section>
    </main>
  </body>
</html>
