---
import ReelsCreator from '@/components/ReelsCreator';
import '@/styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Font Cycle</title>
    <script is:inline>
      if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <main class="relative overflow-hidden px-4 py-6 md:px-8 md:py-8">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(24,24,27,0.08),_transparent_42%)]" />

      <div class="relative mx-auto max-w-7xl space-y-8">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="space-y-3">
            <a
              class="inline-flex items-center rounded-full border border-border bg-background px-4 py-2 text-sm text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
              href="/"
            >
              Back home
            </a>
            <div class="space-y-2">
              <p class="text-sm uppercase tracking-[0.28em] text-muted-foreground">Tools / Font Cycle</p>
              <h1 class="text-3xl font-semibold tracking-tight text-foreground md:text-5xl">
                Font cycle
              </h1>
            </div>
          </div>

          <p class="max-w-md text-sm leading-6 text-muted-foreground md:text-base">
            Upload one still image, edit the headline in place, tune the font rotation speed, and export a one minute font cycle.
          </p>
        </div>

        <ReelsCreator client:load />
      </div>
    </main>
  </body>
</html>
