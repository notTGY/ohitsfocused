---
import '@/styles/global.css';
import SeoHead from '@/components/SeoHead.astro';
const { title, description, seoTitle = `${title} — free browser tool`, image, imageAlt } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: seoTitle,
  url: canonical.href,
  description,
  isPartOf: { '@type': 'WebSite', name: "Oh it's focused", url: new URL('/', Astro.site).href },
};
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Tools', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: title, item: canonical.href },
  ],
};
---
<html lang="en" class="dark">
  <head><SeoHead title={seoTitle} description={description} image={image} imageAlt={imageAlt} schemas={[schema, breadcrumbs]} /><slot name="head" /></head>
  <body class="min-h-dvh antialiased">
    <main class="mx-auto max-w-6xl px-4 py-4 sm:px-6">
      <header class="mb-5 flex min-h-11 items-center gap-3 text-sm">
        <a href="/" aria-label="All tools" class="inline-flex min-h-11 items-center text-muted-foreground hover:text-foreground">← Tools</a>
        <span aria-hidden="true" class="text-muted-foreground/50">/</span>
        <h1 class="font-medium">{title}</h1>
      </header>
      <slot />
    </main>
  </body>
</html>
