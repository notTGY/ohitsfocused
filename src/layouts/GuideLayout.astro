---
import '@/styles/global.css';
import SeoHead from '@/components/SeoHead.astro';
const { title, description, image, imageAlt, seoTitle = title } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = image && new URL(image, Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  mainEntityOfPage: canonical.href,
  inLanguage: 'en',
  publisher: { '@type': 'Organization', name: "Oh it's focused", url: new URL('/', Astro.site).href },
  name: title,
  description,
  url: canonical.href,
  isPartOf: { '@type': 'WebSite', name: "Oh it's focused", url: new URL('/', Astro.site).href },
  ...(image && { image: socialImage }),
};
const breadcrumbs = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Tools', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: title, item: canonical.href },
  ],
};
---
<html lang="en" class="dark">
  <head><SeoHead title={seoTitle} description={description} image={image} imageAlt={imageAlt} type="article" schemas={[schema, breadcrumbs]} /></head>
  <body class="min-h-dvh antialiased">
    <main class="mx-auto max-w-5xl px-4 py-4 sm:px-6">
      <header class="mb-8 flex min-h-11 items-center gap-3 text-sm">
        <a href="/" class="inline-flex min-h-11 items-center text-muted-foreground hover:text-foreground">← Tools</a>
        <span aria-hidden="true" class="text-muted-foreground/50">/</span>
        <span class="font-medium">Blog</span>
      </header>
      <slot />
    </main>
  </body>
</html>
